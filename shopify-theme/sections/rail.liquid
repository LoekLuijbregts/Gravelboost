<section class="rail-section">
  <div class="wrap">
    <h2>{{ section.settings.heading }}</h2>
    <p>{{ section.settings.text }}</p>
    <ul class="rail">
      {%- for block in section.blocks -%}
        <li {{ block.shopify_attributes }}>
          {% render 'pic', image: block.settings.image, asset: block.settings.asset, alt: block.settings.alt, sizes: '460px' %}
          <div class="rail-copy"><strong>{{ block.settings.title }}</strong><small>{{ block.settings.credit }}</small></div>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>
{% schema %}
{
  "name": "Photo rail",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Ridden, not rendered." },
    { "type": "text", "id": "text", "label": "Text", "default": "Ten years of gravel and adventure rides, photographed on the road." }
  ],
  "blocks": [
    {
      "type": "photo", "name": "Photo",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "asset", "label": "Bundled image file", "default": "rail-cappadocia.webp" },
        { "type": "text", "id": "alt", "label": "Image description" },
        { "type": "text", "id": "title", "label": "Place" },
        { "type": "text", "id": "credit", "label": "Credit", "default": "by Loek Luijbregts" }
      ]
    }
  ],
  "presets": [{ "name": "Photo rail" }]
}
{% endschema %}
