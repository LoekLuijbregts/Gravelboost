<div class="wrap">
  <div class="coll-head">
    <p class="eyebrow">Shop</p>
    <h1 class="display">{{ collection.title }}</h1>
    {% if collection.description != blank %}<div class="lead">{{ collection.description }}</div>{% endif %}
  </div>
  {%- paginate collection.products by 12 -%}
    {%- if collection.products.size == 0 -%}
      <p class="empty">No products here yet.</p>
    {%- else -%}
      <div class="grid">{%- for product in collection.products -%}{% render 'product-card', product: product %}{%- endfor -%}</div>
    {%- endif -%}
    {%- if paginate.pages > 1 -%}
      <nav class="pager" aria-label="Pagination">
        {% if paginate.previous %}<a class="btn btn--ghost" href="{{ paginate.previous.url }}">Previous</a>{% endif %}
        {% if paginate.next %}<a class="btn btn--ghost" href="{{ paginate.next.url }}">Next</a>{% endif %}
      </nav>
    {%- endif -%}
  {%- endpaginate -%}
</div>
<div style="height:3rem"></div>
{% schema %}{ "name": "Collection" }{% endschema %}
