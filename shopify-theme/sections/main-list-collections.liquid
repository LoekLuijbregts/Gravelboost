<div class="wrap">
  <div class="coll-head"><h1 class="display">Collections</h1></div>
  <div class="grid">
    {%- for collection in collections -%}
      <a class="card" href="{{ collection.url }}">
        <div class="card-media">{% render 'pic', image: collection.image, asset: 'product-pack.webp', alt: collection.title, sizes: '(min-width: 900px) 30vw, 100vw' %}</div>
        <div class="card-body"><h3>{{ collection.title }}</h3></div>
      </a>
    {%- endfor -%}
  </div>
</div>
<div style="height:3rem"></div>
{% schema %}{ "name": "Collections list" }{% endschema %}
