{%- assign coll = section.settings.collection | default: collections.all -%}
<section class="section" id="shop">
  <div class="wrap">
    <div class="section-head">
      <h2>{{ section.settings.heading }}</h2>
      <a class="link-go" href="{{ coll.url }}">Shop all</a>
    </div>
    <div class="grid">
      {%- for product in coll.products limit: section.settings.limit -%}{% render 'product-card', product: product %}{%- endfor -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Featured products",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Ride packs and tools" },
    { "type": "collection", "id": "collection", "label": "Collection (all products if empty)" },
    { "type": "range", "id": "limit", "label": "Products", "min": 3, "max": 12, "step": 1, "default": 6 }
  ],
  "presets": [{ "name": "Featured products" }]
}
{% endschema %}
