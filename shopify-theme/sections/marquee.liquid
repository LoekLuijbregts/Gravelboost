{%- assign items = section.settings.items | split: ',' -%}
<div class="marquee" aria-hidden="true"><div class="marquee-track">
  {%- for i in (1..3) -%}{%- for item in items -%}<span>{{ item | strip }}</span>{%- endfor -%}{%- endfor -%}
</div></div>
{% schema %}
{ "name": "Marquee", "settings": [ { "type": "text", "id": "items", "label": "Items, comma separated", "default": "Iceland, Luxembourg, Cappadocia, Scotland, Gran Canaria, Cyprus, Tilburg, Morocco" } ], "presets": [{ "name": "Marquee" }] }
{% endschema %}
