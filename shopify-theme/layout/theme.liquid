<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ page_title }}{% unless page_title contains shop.name %} | {{ shop.name }}{% endunless %}</title>
    {% if page_description %}<meta name="description" content="{{ page_description | escape }}">{% endif %}
    <link rel="canonical" href="{{ canonical_url }}">
    <link rel="preload" href="{{ 'archivo-latin-800-normal.woff2' | asset_url }}" as="font" type="font/woff2" crossorigin>
    <link rel="preload" href="{{ 'source-sans-3-latin-400-normal.woff2' | asset_url }}" as="font" type="font/woff2" crossorigin>
    <link rel="stylesheet" href="{{ 'base.css' | asset_url }}">
    <meta name="theme-color" content="#16211b">
    {{ content_for_header }}
  </head>
  <body>
    <a class="skip" href="#main">{{ 'general.skip' | t }}</a>
    {% sections 'header-group' %}
    <main id="main">{{ content_for_layout }}</main>
    {% sections 'footer-group' %}
    <script src="{{ 'theme.js' | asset_url }}" defer></script>
  </body>
</html>
