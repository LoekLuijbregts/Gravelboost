---
import { WORLD } from '../data/world';
import Photo from './Photo.astro';
---
<section class="rail-section" aria-labelledby="rail-h">
  <div class="wrap rail-head">
    <h2 id="rail-h">Where the bike has been</h2>
    <p>No guide yet for these. Which one do you want next?</p>
    <a class="link-go link-go--light" href="/request-a-route/">Tell us</a>
  </div>
  <ul class="rail" tabindex="0" aria-label="Places we rode, scroll sideways">
    {WORLD.map((w) => (
      <li>
        <Photo set="world" photo={{ file: w.file, alt: w.alt, credit: w.credit }} ratio="portrait" caption={false} sizes="(min-width: 900px) 30vw, 78vw" />
        <div class="rail-copy"><strong>{w.place}</strong><span>{w.note}</span><small>{w.credit}</small></div>
      </li>
    ))}
  </ul>
</section>
