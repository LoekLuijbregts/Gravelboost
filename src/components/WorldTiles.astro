---
import { getCollection } from 'astro:content';
import Photo from './Photo.astro';

const ORDER = ['iceland', 'cappadocia', 'morocco', 'canary-islands', 'cyprus', 'vosges', 'sweden', 'girona', 'costa-blanca', 'scotland'];
const previews = (await getCollection('previews')).sort((a, b) => ORDER.indexOf(a.id) - ORDER.indexOf(b.id));
---
<section class="section" aria-labelledby="world-h">
  <div class="wrap">
    <h2 id="world-h">More places we rode</h2>
    <p class="lead">No guide yet, only photos. Tell us which one you want next.</p>
    <div class="tiles">
      {previews.map((w) => (
        <a class="tile" href={`/places/${w.id}/`}>
          <div class="tile-img"><Photo set={`places/${w.id}`} photo={w.data.photos[0]} ratio="card" caption={false} sizes="(min-width: 1100px) 400px, (min-width: 700px) 50vw, 100vw" /><span class="tile-bike">No guide yet</span></div>
          <h3>{w.data.name}</h3>
          <p class="tile-train">{w.data.country} · {w.data.note}</p>
          <p class="tile-credit">{w.data.photos[0].credit}</p>
        </a>
      ))}
    </div>
  </div>
</section>
