---
import Photo from './Photo.astro';

interface Props { set: string; photos: { file: string; alt: string; credit: string; caption?: string; focus?: string }[]; skip?: number }
const { set, photos, skip = 1 } = Astro.props;
---
<section class="section" aria-labelledby="gallery-h">
  <div class="wrap">
    <h2 id="gallery-h">Photos</h2>
    <div class="gallery">
      {photos.slice(skip).map((p) => <Photo set={set} photo={p} ratio="auto" sizes="(min-width: 900px) 360px, (min-width: 600px) 50vw, 100vw" />)}
    </div>
  </div>
</section>
