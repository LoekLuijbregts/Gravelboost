---
import { ENV } from '../lib/site';
---
<form class="inline-form" data-form="newsletter" data-portal={ENV.hubspotPortal} data-form-id={ENV.newsletterForm} data-msg-ok="Thanks. Check your inbox soon." data-msg-error="Something went wrong. Please try again." data-msg-sending="Sending..." data-msg-not-connected="[PLACEHOLDER] The newsletter form is not connected to HubSpot yet." novalidate={false}>
  <label class="sr" for="nl-email" style="position:absolute;left:-999px">Email address</label>
  <input id="nl-email" name="email" type="email" required autocomplete="email" placeholder="you@example.com" />
  <button class="btn" type="submit">Subscribe</button>
  <p class="status" role="status" style="flex-basis:100%;margin:0"></p>
</form>
