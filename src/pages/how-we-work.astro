---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import { heroPreload } from '../lib/photos';
import { getEntry } from 'astro:content';
const towers = (await getEntry('journeys', 'all-along-the-watchtowers'))!;
const heroPhoto = towers.data.photos.find((p) => p.file.includes('watchtowers-tower-stop-group'))!;
const preload = await heroPreload('watchtowers', heroPhoto.file);
---
<Layout preload={preload} title="How we work" description="Everything is ridden or walked first. We choose first. A region can fund a trip, never the place on the site. Paid and partner content is always labelled." path="/how-we-work/" crumbs={[{ name: 'How we work', href: '/how-we-work/' }]}>
  <Hero size="short" set="watchtowers" photo={heroPhoto}>
    <h1>How we work</h1>
    <p class="lede" style="margin:0">The rules are short. They do not bend.</p>
  </Hero>
  <section class="section">
    <div class="narrow prose">
      <h2>Ridden first</h2>
      <p>Everything on GravelBoost is ridden and, where it fits, walked by us. We do not write about places we have not been.</p>
      <h2>We choose first</h2>
      <p>I pick the place. After that, a region can pay for the trip. Money can pay for a trip. It can never buy a place on the site.</p>
      <h2>Paid and partner content is labelled</h2>
      <p>If a region paid, you will see the label <span class="tag tag--paid">Commissioned</span>. If a partner offers a deal, you will see <span class="tag tag--partner">Partner content</span>. A quiet line at the bottom of every page says where the page comes from.</p>
      <h2>Honest answers</h2>
      <p>Each journey answers eight questions riders ask. Each answer has a date. If we have not checked an answer yet, the page says so.</p>
      <h2>Example prices</h2>
      <p>While prices are not final, they carry the label <span class="tag tag--example">Example price</span>.</p>
      <h2>Downloads</h2>
      <p>Paid GPX files and guides are sold through our shop as digital downloads.</p>
    </div>
  </section>
</Layout>
