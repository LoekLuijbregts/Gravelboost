---
import { getCollection, getEntries, render } from 'astro:content';
import { heroPreload } from '../../lib/photos';
import Layout from '../../layouts/Layout.astro';
import Hero from '../../components/Hero.astro';
import Months from '../../components/Months.astro';
import Photo from '../../components/Photo.astro';
import Gallery from '../../components/Gallery.astro';
import OffTheBike from '../../components/OffTheBike.astro';
import ProductCard from '../../components/ProductCard.astro';
import Provenance from '../../components/Provenance.astro';
import RouteMap from '../../components/RouteMap.astro';
import { destinationLd, productLd } from '../../lib/schema';
import { hideOpen, SHOW_TODOS } from '../../lib/site';

export async function getStaticPaths() {
  const all = await getCollection('destinations');
  return all.filter((d) => d.data.guide).map((destination) => ({ params: { slug: destination.id }, props: { destination } }));
}
const { destination } = Astro.props;
const d = destination.data;
const { Content } = await render(destination);
const href = `/destinations/${destination.id}/`;
const places = await getEntries(d.basePlaces);
const products = await getEntries(d.products);
const image = `/photos/${d.photoSet}/${d.photos[0].file}`;
const points = places.filter((p) => p.data.coordinates).map((p) => ({ name: p.data.name, coords: p.data.coordinates as [number, number] }));
const ld = [
  destinationLd({ name: d.name, country: d.country, description: d.description, href, image }),
  ...products.map((p) => productLd({ name: p.data.name, description: p.data.summary, price: p.data.price, currency: p.data.currency, examplePrice: p.data.examplePrice, href })),
];
const preload = await heroPreload(d.photoSet, d.photos[0].file);
---
<Layout preload={preload} title={`${d.name} guide`} description={d.description} path={href} noindex={d.noindex} image={image} jsonLd={ld} view="destination" viewName={destination.id} crumbs={[{ name: 'Destinations', href: '/destinations/' }, { name: d.name, href }]}>
  <Hero set={d.photoSet} photo={d.photos[0]}>
    <p class="eyebrow eyebrow--light">Destination guide</p>
    <h1>{d.name}</h1>
        <div class="btn-row">
      <a class="btn" href="#trips">See the trips</a>
      <a class="btn btn--ghost" href="#packs">About the guide</a>
    </div>
  </Hero>

  <section class="section" aria-labelledby="intro-h">
    <div class="wrap story">
      <div class="prose">
        <h2 id="intro-h">Riding {d.name}</h2>
        <p class="intro">{d.intro}</p>
        <Content />
      </div>
      <aside class="fact-card"><dl class="facts">
        <div><dt>Best months</dt><dd><Months months={d.bestMonths} />{d.bestMonthsNote && <span class="muted" style="font-size:.9rem">{d.bestMonthsNote}</span>}</dd></div>
        <div><dt>Getting there and around</dt><dd>{d.arrival}</dd></div>
        <div><dt>Ridden</dt><dd>{d.visited}</dd></div>
      </dl></aside>
    </div>
  </section>

  <section class="section" style="padding-top:0" aria-labelledby="places-h">
    <div class="wrap">
      <h2 id="places-h">Where to base yourself</h2>
      <RouteMap points={points} />
      <ul class="otb otb--grid" style="margin-top:1.2rem">
        {places.map((p) => <li><h3>{p.data.name}</h3><p style="margin:0">{p.data.why}</p></li>)}
      </ul>
    </div>
  </section>

  <section class="section" id="trips" style="padding-top:0" aria-labelledby="trips-h">
    <div class="wrap">
      <h2 id="trips-h">Three example trips</h2>
      <div class="grid">
        {d.trips.map((t, i) => (
          <article class="card">
            <Photo set={d.photoSet} photo={[d.photos[3], d.photos[6], d.photos[9]][i]} ratio="card" caption={false} sizes="(min-width: 1100px) 400px, (min-width: 700px) 50vw, 100vw" />
            <div class="card-body">
              <p style="margin:0">{t.access === 'preview' ? <span class="tag tag--free">Free preview</span> : <span class="tag tag--example">In the guide</span>}</p>
              <h3>{t.title}</h3>
              <p class="muted" style="font-size:.95rem">{t.area}</p>
              {!hideOpen(t.distanceKm) && (
                <ul class="stats">
                  <li><span class="k">Distance</span><span class="v">{t.distanceKm}</span></li>
                  <li><span class="k">Climbing</span><span class="v">{t.ascentM}</span></li>
                  <li><span class="k">Time</span><span class="v">{t.days}</span></li>
                  <li><span class="k">Level</span><span class="v">{t.level}</span></li>
                </ul>
              )}
              <p>{t.summary}</p>
              <div class="btn-row">
                {t.access === 'preview'
                  ? (SHOW_TODOS && <span class="btn btn--ghost" aria-disabled="true">Free GPX [PLACEHOLDER]</span>)
                  : <a class="btn btn--ghost" href="#packs" data-event="pack_click" data-label={destination.id}>In the guide</a>}
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <OffTheBike items={d.offTheBike} />
  <Gallery set={d.photoSet} photos={d.photos} />

  <section class="section section--white" id="packs" aria-labelledby="packs-h">
    <div class="wrap">
      <h2 id="packs-h">The guide</h2>
      <div class="grid">{products.map((p) => <ProductCard product={p} />)}</div>
      <Provenance text={d.provenance.text} paid={d.provenance.paid} />
    </div>
  </section>
</Layout>
