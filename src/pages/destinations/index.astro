---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Photo from '../../components/Photo.astro';

const destinations = await getCollection('destinations');
const bundles = [
  { href: '/bundles/all-along-the-watchtowers/', title: 'All Along The Watchtowers', text: 'Five routes from Tilburg along five lookout towers.' },
];
---
<Layout title="Destinations" description="Where we ride: Luxembourg, Tilburg and the Watchtowers routes. Accessible adventures across Europe." path="/destinations/" crumbs={[{ name: 'Destinations', href: '/destinations/' }]}>
  <section class="section">
    <div class="wrap">
      <h1>Destinations</h1>
      <p class="muted" style="max-width:40rem">Each destination is ridden first. Pick a place, then pick a journey.</p>
      <div class="grid">
        {destinations.map((d) => (
          <article class="card">
            <Photo set={d.data.photoSet} photo={d.data.photos[0]} ratio="card" caption={false} />
            <div class="card-body">
              <p class="eyebrow" style="margin:0">{d.data.country}</p>
              <h3><a href={d.data.href}>{d.data.name}</a></h3>
              <p>{d.data.description}</p>
              <div class="btn-row"><a class="btn btn--ghost" href={d.data.href}>{d.data.guide ? 'Read the guide' : 'See the journey'}</a></div>
            </div>
          </article>
        ))}
        {bundles.map((b) => (
          <article class="card">
            <div class="card-body">
              <p class="eyebrow" style="margin:0">Bundle · Netherlands</p>
              <h3><a href={b.href}>{b.title}</a></h3>
              <p>{b.text}</p>
              <div class="btn-row"><a class="btn btn--ghost" href={b.href}>See the bundle</a></div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
</Layout>
