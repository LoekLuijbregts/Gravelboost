---
import { getCollection, getEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import PlaceTile from '../../components/PlaceTile.astro';
import WorldTiles from '../../components/WorldTiles.astro';

const destinations = await getCollection('destinations');
const towers = (await getEntry('journeys', 'all-along-the-watchtowers'))!;
const lux = destinations.find((d) => d.id === 'luxembourg')!;
const til = destinations.find((d) => d.id === 'tilburg')!;
---
<Layout title="Destinations" description="Where we ride: Luxembourg, Tilburg and the Watchtowers routes. Accessible adventures across Europe." path="/destinations/" crumbs={[{ name: 'Destinations', href: '/destinations/' }]}>
  <section class="section section--tight">
    <div class="wrap">
      <h1 class="page-title">Destinations</h1>
      <p class="lead">Each one is ridden first. Pick a place, then pick a ride.</p>
      <div class="tiles">
        <PlaceTile href={lux.data.href} set={lux.data.photoSet} photo={lux.data.photos[9]} eyebrow="Luxembourg · Guide" title={lux.data.name} text={lux.data.description} />
        <PlaceTile href={til.data.href} set={til.data.photoSet} photo={til.data.photos[0]} eyebrow="Netherlands · Two loops" title={til.data.name} text={til.data.description} />
        <PlaceTile href="/bundles/all-along-the-watchtowers/" set={towers.data.photoSet} photo={towers.data.photos[0]} eyebrow="Netherlands · Five loops" title="All Along The Watchtowers" text={towers.data.description} />
      </div>
    </div>
  </section>
  <WorldTiles />
</Layout>
