---
import { getEntry } from 'astro:content';
import { heroPreload } from '../lib/photos';
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Finder from '../components/Finder.astro';
import PlaceTile from '../components/PlaceTile.astro';
import WorldTiles from '../components/WorldTiles.astro';
import Photo from '../components/Photo.astro';
import LevelScale from '../components/LevelScale.astro';
import { TAGLINE } from '../lib/site';

const tilburg = (await getEntry('journeys', 'tilburg'))!;
const towers = (await getEntry('journeys', 'all-along-the-watchtowers'))!;
const lux = (await getEntry('destinations', 'luxembourg'))!;
const pick = (list: { file: string; alt: string; credit: string; focus?: string }[], key: string) => list.find((p) => p.file.includes(key))!;
const heroPhoto = pick(towers.data.photos, 'oak-avenue');
const me = { file: 'loek-luijbregts-selfie-by-loek-luijbregts.webp', alt: 'Loek Luijbregts in cycling kit and helmet, taking a selfie with a camera around his neck and his bike in front of him.', credit: 'by Loek Luijbregts' };
const preload = await heroPreload(towers.data.photoSet, heroPhoto.file);
---
<Layout preload={preload} home title="Home" description="Gravel and adventure rides across Europe that do not have to be extreme. Every route is ridden first, with honest answers and a GPX." path="/" image={`/photos/${towers.data.photoSet}/${heroPhoto.file}`}>
  <Hero size="home" set={towers.data.photoSet} photo={heroPhoto}>
    <h1>{TAGLINE}</h1>
    <p class="lede">Adventure does not have to be extreme. Every route here is ridden first, and we tell you what to expect.</p>
  </Hero>

  <section class="section section--tight" id="ride" aria-labelledby="find-h">
    <div class="wrap">
      <h2 id="find-h">Find your ride</h2>
      <Finder />
    </div>
  </section>

  <section class="section section--white" aria-labelledby="dest-h">
    <div class="wrap">
      <h2 id="dest-h">Destinations</h2>
      <div class="tiles">
        <PlaceTile href="/destinations/luxembourg/" set={lux.data.photoSet} photo={pick(lux.data.photos, 'red-earth')} eyebrow="Luxembourg · Guide" title="Luxembourg" text="Ardennes, Mullerthal and the red-earth south. Public transport is free, so no car needed." />
        <PlaceTile href="/journeys/tilburg/" set={tilburg.data.photoSet} photo={tilburg.data.photos[0]} eyebrow="Netherlands · Two loops" title="Tilburg" text="Two loops by the station. Then a city with plenty to do when the bike is parked." />
        <PlaceTile href="/bundles/all-along-the-watchtowers/" set={towers.data.photoSet} photo={towers.data.photos[0]} eyebrow="Netherlands · Five loops" title="All Along The Watchtowers" text="Five loops around Tilburg past five lookout towers, on gravel and on the road." />
      </div>
    </div>
  </section>

  <WorldTiles />

  <section class="section section--white" aria-labelledby="level-h">
    <div class="wrap">
      <h2 id="level-h">How hard is it?</h2>
      <p class="lead">Every ride has a level from 1 to 5. Our routes so far sit at 2 and 3, on purpose.</p>
      <LevelScale />
    </div>
  </section>

  <section class="section" aria-labelledby="who-h">
    <div class="wrap about">
      <Photo set="about" photo={me} ratio="portrait" caption={false} sizes="(min-width: 800px) 340px, 100vw" />
      <div>
        <p class="eyebrow">Who rides first</p>
        <h2 id="who-h">Loek Luijbregts</h2>
        <p class="lead">Rider, route maker and cycling tourism strategist. 30+ gravel regions ridden across Europe, Africa and beyond.</p>
        <p>I choose where to ride first. A region can pay for a trip after that. It can never buy a place on this site. Paid and partner content is always labelled.</p>
        <div class="btn-row">
          <a class="link-go" href="/how-we-work/">How we work</a>
          <a class="link-go" href="/request-a-route/">Want us in your region?</a>
        </div>
      </div>
    </div>
  </section>
</Layout>
