---
import { getEntry } from 'astro:content';
import { heroPreload } from '../lib/photos';
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Photo from '../components/Photo.astro';
import LevelScale from '../components/LevelScale.astro';
import { getGpx } from '../lib/gpx';
import { euro, TAGLINE } from '../lib/site';

const tilburg = (await getEntry('journeys', 'tilburg'))!;
const towers = (await getEntry('journeys', 'all-along-the-watchtowers'))!;
const lux = (await getEntry('destinations', 'luxembourg'))!;
const pack = (await getEntry('products', 'tilburg-ride-pack'))!;
const pick = (list: { file: string; alt: string; credit: string; focus?: string }[], key: string) => list.find((p) => p.file.includes(key))!;
const heroPhoto = pick(towers.data.photos, 'heather-track-drone');
const avenue = pick(towers.data.photos, 'oak-avenue');
const g1 = getGpx(tilburg.data.loops[0].gpx)!;
const g2 = getGpx(tilburg.data.loops[1].gpx)!;
const tw = towers.data.loops.map((l) => getGpx(l.gpx)!);
const twMin = Math.round(Math.min(...tw.map((g) => g.distanceKm)));
const twMax = Math.round(Math.max(...tw.map((g) => g.distanceKm)));
const me = { file: 'loek-luijbregts-selfie-by-loek-luijbregts.webp', alt: 'Loek Luijbregts in cycling kit and helmet, taking a selfie with a camera around his neck and his bike in front of him.', credit: 'by Loek Luijbregts' };
const preload = await heroPreload(towers.data.photoSet, heroPhoto.file);
---
<Layout preload={preload} home title="Home" description="Gravel and adventure rides across Europe that do not have to be extreme. Every route is ridden first, with honest answers and a GPX." path="/" image={`/photos/${towers.data.photoSet}/${heroPhoto.file}`}>
  <Hero set={towers.data.photoSet} photo={heroPhoto}>
    <p class="eyebrow eyebrow--light">Go out on gravel. Come back different.</p>
    <h1>{TAGLINE}</h1>
    <p class="lede">Adventure riding does not have to be extreme. Every route here is ridden first, and we tell you what to expect.</p>
    <div class="btn-row">
      <a class="btn" href="/destinations/">Find a ride</a>
      <a class="btn btn--ghost" href="/start-here/">Start here</a>
    </div>
  </Hero>

  <div class="band">
    <ul class="wrap promises">
      <li><strong>Ridden first</strong>No route goes online before we rode it.</li>
      <li><strong>Honest answers</strong>Eight rider questions, each with a date.</li>
      <li><strong>Level 1 to 5</strong>You know how hard it is before you go.</li>
      <li><strong>No hidden deals</strong>Paid and partner content is always labelled.</li>
    </ul>
  </div>

  <section class="section" aria-labelledby="featured-h">
    <div class="wrap">
      <h2 id="featured-h">Where to ride</h2>
      <article class="feature">
        <Photo set={tilburg.data.photoSet} photo={tilburg.data.photos[0]} ratio="card" caption={false} sizes="(min-width: 900px) 560px, 100vw" />
        <div class="feature-body">
          <p class="eyebrow" style="margin:0">Netherlands · Arrive by train</p>
          <h3><a href="/journeys/tilburg/">Tilburg: two loops from the station</a></h3>
          <p>A gravel loop for an easy day and a mountain bike loop for a big one. Then a city with plenty to do when the bike is parked.</p>
          <dl class="mini">
            <div><dt>Gravel</dt><dd>{g1.distanceKm} km</dd></div>
            <div><dt>Mountain bike</dt><dd>{g2.distanceKm} km</dd></div>
            <div><dt>Ride Pack</dt><dd>{euro(pack.data.price)}</dd></div>
          </dl>
          <div class="btn-row">
            <a class="btn" href="/journeys/tilburg/">See the journey</a>
            {pack.data.shopifyUrl && <a class="btn btn--ghost" href={pack.data.shopifyUrl} data-event="purchase_click" data-label="tilburg-ride-pack">Buy the Ride Pack</a>}
          </div>
        </div>
      </article>
      <div class="grid grid--two" style="margin-top:1.2rem">
        <article class="card">
          <Photo set={towers.data.photoSet} photo={towers.data.photos[0]} ratio="card" caption={false} sizes="(min-width: 900px) 550px, 100vw" />
          <div class="card-body">
            <p class="eyebrow" style="margin:0">Netherlands · Gravel and road</p>
            <h3><a href="/bundles/all-along-the-watchtowers/">All Along The Watchtowers</a></h3>
            <p>Five loops around Tilburg past five lookout towers, from {twMin} to {twMax} km.</p>
            <div class="btn-row"><a class="btn btn--ghost" href="/bundles/all-along-the-watchtowers/">See the routes</a></div>
          </div>
        </article>
        <article class="card">
          <Photo set={lux.data.photoSet} photo={pick(lux.data.photos, 'red-earth')} ratio="card" caption={false} sizes="(min-width: 900px) 550px, 100vw" />
          <div class="card-body">
            <p class="eyebrow" style="margin:0">Luxembourg · Destination guide</p>
            <h3><a href="/destinations/luxembourg/">Luxembourg</a></h3>
            <p>Ardennes, Mullerthal and the red-earth south. Public transport is free, so no car needed.</p>
            <div class="btn-row"><a class="btn btn--ghost" href="/destinations/luxembourg/">Read the guide</a></div>
          </div>
        </article>
      </div>
    </div>
  </section>

  <section class="quote" aria-labelledby="quote-h">
    <Photo set={towers.data.photoSet} photo={avenue} ratio="hero" caption={false} sizes="100vw" />
    <div class="quote-copy">
      <div class="wrap">
        <h2 id="quote-h">Not a list of routes.<br />A rider's honest account.</h2>
        <p>Every guide is built from a ride that actually happened. Where to sleep, what the gravel is really like, what you need to bring. The things no travel blog tells you.</p>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="level-h">
    <div class="wrap">
      <h2 id="level-h">Adventure, without the extreme</h2>
      <p class="muted" style="max-width:40rem">Every journey has a level. Our routes so far sit at level 2 and 3, on purpose.</p>
      <LevelScale />
    </div>
  </section>

  <section class="section section--white" aria-labelledby="who-h">
    <div class="wrap about">
      <Photo set="about" photo={me} ratio="portrait" caption={false} sizes="(min-width: 900px) 340px, 100vw" />
      <div>
        <p class="eyebrow">Who rides first</p>
        <h2 id="who-h">Loek Luijbregts</h2>
        <p>Rider, route maker and cycling tourism strategist. 30+ gravel regions ridden across Europe, Africa and beyond. 110M+ earned impressions for destinations that let real riders tell their stories.</p>
        <p>I choose where to ride first. A region can pay for a trip after that. It can never buy a place on this site.</p>
        <div class="btn-row">
          <a class="btn btn--ghost" href="/how-we-work/">How we work</a>
          <a class="btn btn--green" href="/request-a-route/">Want us in your region?</a>
        </div>
      </div>
    </div>
  </section>
</Layout>
