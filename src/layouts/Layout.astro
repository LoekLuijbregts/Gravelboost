---
import '@fontsource/archivo/latin-600.css';
import '@fontsource/archivo/latin-800.css';
import '@fontsource/source-sans-3/latin-400.css';
import '@fontsource/source-sans-3/latin-600.css';
import '../styles/global.css';
import { ENV, LANGS, NAME, TAGLINE } from '../lib/site';
import { abs, breadcrumbs } from '../lib/schema';
import Newsletter from '../components/Newsletter.astro';
import archivo800 from '@fontsource/archivo/files/archivo-latin-800-normal.woff2?url';
import archivo600 from '@fontsource/archivo/files/archivo-latin-600-normal.woff2?url';
import sans400 from '@fontsource/source-sans-3/files/source-sans-3-latin-400-normal.woff2?url';
import sans600 from '@fontsource/source-sans-3/files/source-sans-3-latin-600-normal.woff2?url';

interface Props {
  title: string;
  description: string;
  path: string;
  crumbs?: { name: string; href: string }[];
  noindex?: boolean;
  image?: string;
  jsonLd?: object[];
  view?: 'journey' | 'destination';
  viewName?: string;
  home?: boolean;
  plain?: boolean;
  preload?: { srcset: string; media: string; sizes?: string }[];
}
const { title, description, path, crumbs = [], noindex = false, image, jsonLd = [], view, viewName, home = false, plain = false, preload = [] } = Astro.props;
const fullTitle = home ? `${NAME}: ${TAGLINE}` : `${title} | ${NAME}`;
const robots = noindex || !ENV.allowIndex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large';
const ogImage = image ? abs(`/.netlify/images?url=${encodeURIComponent(image)}&w=1200&h=630&fit=cover&fm=jpg&q=80`) : undefined;
const trail = home ? [] : [{ name: 'Home', href: '/' }, ...crumbs];
const nav = [
  { href: '/destinations/', label: 'Destinations' },
  { href: '/start-here/', label: 'Start here' },
  { href: '/how-we-work/', label: 'How we work' },
  { href: '/request-a-route/', label: 'Request a route' },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    {noindex && <meta name="gb-page-noindex" content="true" />}
    <link rel="canonical" href={abs(path)} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={NAME} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={abs(path)} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {[archivo800, archivo600, sans400, sans600].map((f) => <link rel="preload" href={f} as="font" type="font/woff2" crossorigin />)}
    {preload.map((p) => <link rel="preload" as="image" imagesrcset={p.srcset} imagesizes={p.sizes ?? '100vw'} media={p.media} fetchpriority="high" />)}
    {trail.length > 0 && <script type="application/ld+json" set:html={JSON.stringify(breadcrumbs(trail))} />}
    {jsonLd.map((ld) => <script type="application/ld+json" set:html={JSON.stringify(ld)} />)}
  </head>
  <body data-ga={ENV.ga4} data-view={view} data-view-name={viewName}>
    <a class="skip" href="#main">Skip to content</a>
    <header class:list={['site-header', { 'site-header--plain': plain }]}>
      <div class="wrap bar">
        <a class="brand" href="/" translate="no">Gravel<span>Boost</span></a>
        <nav class="nav-desktop" aria-label="Main">
          {nav.map((n) => <a href={n.href} aria-current={path === n.href ? 'page' : undefined}>{n.label}</a>)}
        </nav>
        <details class="menu">
          <summary aria-label="Menu">Menu</summary>
          <nav aria-label="Main, mobile">
            {nav.map((n) => <a href={n.href} aria-current={path === n.href ? 'page' : undefined}>{n.label}</a>)}
          </nav>
        </details>
        <details class="lang" data-lang-menu>
          <summary aria-label="Language">EN</summary>
          <ul>
            {LANGS.map((l) => (
              <li><a data-lang-link={l.code} hreflang={l.code} lang={l.code} href={path} data-event="language_switch" data-label={l.code}>{l.label}</a></li>
            ))}
          </ul>
        </details>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap">
        <p class="foot-claim">Go out on gravel.<br />Come back different.</p>
        <div class="foot-grid">
          <div>
            <h2>New routes by email</h2>
            <Newsletter />
          </div>
          <ul class="foot-links">
            <li><a href="/destinations/">Destinations</a></li>
            <li><a href="/how-we-work/">How we work</a></li>
            <li><a href="/request-a-route/">Request a route</a></li>
            <li><a href="/privacy/">Privacy and cookies</a></li>
            <li><button type="button" class="linklike" data-consent-open>Cookie settings</button></li>
          </ul>
        </div>
        <p class="foot-small"><span translate="no">GravelBoost</span> is a project of Cycling Incubators. {TAGLINE}.</p>
      </div>
    </footer>
    <div id="consent" class="consent" role="dialog" aria-labelledby="consent-title" hidden>
      <div class="wrap inner">
        <p id="consent-title">Analytics cookies stay off unless you say yes. <a href="/privacy/">Read the privacy policy</a></p>
        <div class="btn-row">
          <button type="button" class="btn" id="consent-accept">Accept</button>
          <button type="button" class="btn btn--ghost" id="consent-decline">Decline</button>
        </div>
      </div>
    </div>
    <script>
      import '../scripts/site';
    </script>
  </body>
</html>
